$TTL    86400
@       IN      SOA     ns1.test.lan. admin.test.lan. (
                        4  ; Número de serie
                        3600        ; Actualización (Refresh)
                        1800        ; Reintento (Retry)
                        1209600     ; Caducidade (Expire)
                        86400 )     ; TTL mínimo

; Servidores de nomes
@       IN      NS      ns1.test.lan.
9       IN      PTR     ns1.test.lan.